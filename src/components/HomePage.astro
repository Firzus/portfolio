---
import GithubIcon from "iconoir/icons/regular/github.svg";
import LinkedinIcon from "iconoir/icons/regular/linkedin.svg";
import MailIcon from "iconoir/icons/regular/mail.svg";
import { m } from "../paraglide/messages.js";

const contacts = [
  { href: "https://www.linkedin.com/in/lprieu/", label: m.contact_linkedin(), icon: LinkedinIcon },
  { href: "mailto:lprieu.infos@gmail.com", label: m.contact_email(), icon: MailIcon },
  { href: "https://github.com/Firzus", label: m.contact_github(), icon: GithubIcon },
];
---

<main class="relative mx-auto flex min-h-[70vh] max-w-3xl flex-col justify-center gap-10 px-6">
  <canvas data-scene aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 size-full"></canvas>
  <div data-reveal>
    <h1 class="font-display text-5xl font-semibold tracking-tight">Lilian PRIEU</h1>
    <p class="mt-3 text-xl text-muted">{m.job_title()}</p>
  </div>
  <section data-reveal aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="text-sm font-medium tracking-wide text-muted uppercase">
      {m.contact_heading()}
    </h2>
    <ul class="mt-4 flex flex-wrap gap-6">
      {
        contacts.map(({ href, label, icon: Icon }) => (
          <li>
            <a href={href} class="inline-flex items-center gap-2 hover:text-accent" data-contact>
              <Icon width={20} height={20} aria-hidden="true" />
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</main>

<script>
  import "../scripts/home";
</script>
