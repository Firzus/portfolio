---
import LanguageIcon from "iconoir/icons/regular/language.svg";
import type { LocalizedPage } from "../i18n/routing";
import { m } from "../paraglide/messages.js";
import type { Locale } from "../paraglide/runtime.js";

interface Props {
  pages: LocalizedPage[];
  currentLocale: Locale;
}

const { pages, currentLocale } = Astro.props;
const otherPages = pages.filter((page) => page.locale !== currentLocale);
---

<nav aria-label={m.language_switcher_label()}>
  <ul class="flex gap-4">
    {
      otherPages.map((page) => (
        <li>
          <a
            href={page.href}
            hreflang={page.locale}
            lang={page.locale}
            data-language-switch
            class="inline-flex items-center gap-2 text-muted hover:text-ink"
          >
            <LanguageIcon width={20} height={20} aria-hidden="true" />
            {m.language_name({}, { locale: page.locale })}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
