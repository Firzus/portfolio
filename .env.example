# Contact form (Resend). Validated by src/lib/env.ts at send time.
# Copy to .env and fill in. In production, set these in Vercel project settings.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Recipient of contact form submissions (the candidate's inbox)
CONTACT_TO_EMAIL=you@example.com

# Verified Resend sender address — https://resend.com/domains
# Use "Your Name <sender@your-domain.com>" or a bare address.
CONTACT_FROM_EMAIL=contact@your-domain.com
