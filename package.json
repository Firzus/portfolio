    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "iconoir-react": "^7.12.2",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shaders": "^4.0.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@inlang/cli": "^3.4.5",
    "@inlang/paraglide-js": "^3.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
